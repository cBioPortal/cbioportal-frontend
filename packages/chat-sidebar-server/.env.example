PORT=4000

# Each provider below is optional and independent — only the ones with
# credentials set will show up in the model dropdown (see AVAILABLE_MODELS
# in src/core.ts). Copy this file to .env.local and fill in what you have.

# anthropic
ANTHROPIC_API_KEY=

# vertex
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=

# bedrock
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY aren't read directly by this
# server — they're picked up by the AWS SDK's default credential chain.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_SONNET_MODEL_ID=

# librechat
LIBRECHAT_BASE_URL=
LIBRECHAT_API_KEY=
LIBRECHAT_AGENT_ID=

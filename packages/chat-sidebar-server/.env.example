PORT=4000
HOST=127.0.0.1

# Comma-separated origins allowed to call this server cross-origin. Irrelevant
# in deployment, where the proxy makes every request same-origin. Any origin is
# allowed when unset, which is what local dev uses.
CORS_ORIGINS=

# Postgres holding chat history — required. Apply the schema with
# `pnpm migrate` before starting the server, and again after pulling a schema
# change. Locally, `docker compose up -d` in this package starts one matching
# this URL.
DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# The user every request is attributed to when no X-Chat-User header arrives.
# Deployed, the portal proxy always sets that header; locally there is no proxy,
# so this stands in for it. Only used by `pnpm dev`, which sets
# NODE_ENV=development.
DEV_CHAT_USER=dev@localhost

# Each user's usage allowance per window, in units — required. Every model call
# is counted in weighted tokens (uncached input × 1, cache read × 0.1, cache
# write × 1.25, output × 5) and a unit is a million of them; units have no money
# value. A user whose usage over the window reaches the allowance is refused
# until enough of it ages out. See src/usage.ts.
CHAT_ALLOWANCE_UNITS=10
# How far back usage counts: a rolling window in hours or days, e.g. 12h or 7d.
# Defaults to 7d.
CHAT_WINDOW=

# Each provider below is optional and independent — only the ones configured
# show up in the model picker, and the first one configured (in the order
# below) is the default. Each has a chat model, used for conversations and
# reports, and a cheaper utility model, used for titles and follow-up
# suggestions; *_CHAT_MODEL_NAME is what the picker shows for the chat model.
# See src/models.ts. Copy this file to .env.local and fill in what you have.

# bedrock — enabled when BEDROCK_CHAT_MODEL is set.
# Credentials come from the standard AWS chain: AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN, AWS_PROFILE (shared config, SSO),
# or a role attached to the container or instance. Alternatively, a Bedrock API
# key in AWS_BEARER_TOKEN_BEDROCK — when set, it takes precedence over the chain.
AWS_REGION=
# Model ID, inference profile ID or ARN, supporting Converse streaming and tool use.
BEDROCK_CHAT_MODEL=
# Defaults to BEDROCK_CHAT_MODEL.
BEDROCK_CHAT_MODEL_NAME=
# Defaults to us.anthropic.claude-haiku-4-5-20251001-v1:0.
BEDROCK_UTILITY_MODEL=

# anthropic — enabled when ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5.
ANTHROPIC_CHAT_MODEL=
# Defaults to ANTHROPIC_CHAT_MODEL, or "Claude Sonnet 5" when that is unset.
ANTHROPIC_CHAT_MODEL_NAME=
# Defaults to claude-haiku-4-5.
ANTHROPIC_UTILITY_MODEL=

# openai — enabled when OPENAI_API_KEY is set.
OPENAI_API_KEY=
# Defaults to gpt-6.1-sol.
OPENAI_CHAT_MODEL=
# Defaults to OPENAI_CHAT_MODEL, or "GPT-6.1 Sol" when that is unset.
OPENAI_CHAT_MODEL_NAME=
# Defaults to gpt-6-luna.
OPENAI_UTILITY_MODEL=

# langfuse (system prompt) — LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY/
# LANGFUSE_HOST are expected in the shell environment, not here. src/
# systemPrompt.md is used directly when credentials are absent and as the
# fallback if a configured Langfuse instance can't be reached.

# mcp — each is optional and independent; a server with no URL set here is
# simply not offered to the model (no hardcoded remote fallback).
NAVIGATOR_MCP_URL=
CBIOPORTAL_MCP_URL=

# Comma-separated hostnames the MCP servers above build their links on. Links
# to these hosts are rewritten to, and opened on, the portal the sidebar is
# embedded in. Defaults to www.cbioportal.org,cbioportal.org when unset.
PORTAL_LINK_ALIASES=
